# Baked into the trackbox24-web image (see ../Dockerfile). Caddy terminates TLS for every host.
{
	email admin@trackbox24.com
}

www.trackbox24.com {
	redir https://trackbox24.com{uri} permanent
}

trackbox24.com {
	encode zstd gzip

	# Same-origin API for the web app — the backend has no CORS configuration.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Hashed build output: cache forever, and never fall back to index.html — a tab left open across a deploy
	# must get a 404 for a chunk that is gone, not HTML it would fail to run as a module.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA: everything else is the built front-end, unknown paths fall back to index.html.
	# index.html itself is revalidated every time, otherwise a browser keeps pointing at the previous build.
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# Mobile app talks to the backend directly.
api.trackbox24.com {
	reverse_proxy api:8080
}

# Grafana (logs). Lives in the infra compose file; Caddy only proxies to it.
logs.trackbox24.com {
	reverse_proxy grafana:3000
}
